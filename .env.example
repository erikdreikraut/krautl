# Kopieren nach .env und mit echten Werten füllen.
# .env NIEMALS ins Git-Repo committen (siehe .gitignore).

# --- Datenbank ---
DATABASE_URL=postgresql+asyncpg://krautl:changeme@localhost:5432/krautl

# --- Claude API ---
ANTHROPIC_API_KEY=

# --- OpenAI API (Audiotranskription) ---
OPENAI_API_KEY=
# Optional; Standard ist das genauere Transkriptionsmodell.
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Kleines, schnelles Modell nur für Absätze, Fettungen und Anrufername.
AUDIO_FORMATTING_MODEL=claude-haiku-4-5-20251001

# --- IMAP-Postfächer (je Postfach ein eigener Block) ---
IMAP_INFO_HOST=imap.deinserver.de
IMAP_INFO_USER=info@dreikraut.de
IMAP_INFO_PASSWORD=

IMAP_SERVICE_HOST=imap.deinserver.de
IMAP_SERVICE_USER=service@dreikraut.de
# Optional: exakter Gesendet-Ordner, falls die automatische Erkennung uneindeutig ist.
# IMAP_SERVICE_SENT_FOLDER=Sent
IMAP_SERVICE_PASSWORD=

# --- SMTP-Versand aus service@dreikraut.de ---
# Antworten gehen ausschließlich an den Absender der Kundenmail.
SMTP_SERVICE_HOST=smtp.deinserver.de
SMTP_SERVICE_PORT=587
SMTP_SERVICE_USER=service@dreikraut.de
SMTP_SERVICE_PASSWORD=

IMAP_EINKAUF_HOST=imap.deinserver.de
IMAP_EINKAUF_USER=einkauf@dreikraut.de
IMAP_EINKAUF_PASSWORD=

IMAP_MARKETING_HOST=imap.deinserver.de
IMAP_MARKETING_USER=marketing@dreikraut.de
IMAP_MARKETING_PASSWORD=

# Als Zielpostfach für Rechnungen erforderlich.
IMAP_ERIK_HOST=imap.deinserver.de
IMAP_ERIK_USER=erik@dreikraut.de
IMAP_ERIK_PASSWORD=

# --- Cloud-Speicher für Anhänge ---
DROPBOX_ACCESS_TOKEN=
# Für dauerhaft laufende Server vorzuziehen (Access Token darf dann leer sein):
DROPBOX_REFRESH_TOKEN=
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=

# --- Dauerbetrieb ---
# Standard: alle 60 Sekunden. Werte unter 10 Sekunden werden auf 10 begrenzt.
MAIL_POLL_INTERVAL_SECONDS=60
LOG_LEVEL=INFO

# --- Web-Oberfläche ---
KRAUTL_ADMIN_TOKEN=

# --- Krautl-Anmeldung ---
# Mindestens 32 zufällige Zeichen; beispielsweise mit:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
KRAUTL_SESSION_SECRET=
KRAUTL_PASSWORD_ERIK=
KRAUTL_PASSWORD_GURSEWAK=
KRAUTL_PASSWORD_LUDWIG=


# WhatsApp bleibt bis zum abgeschlossenen Coexistence-Onboarding deaktiviert.
WHATSAPP_ENABLED=false
# meta (direkte Cloud API) oder 360dialog (dokumentiertes Coexistence-Onboarding)
WHATSAPP_PROVIDER=meta
# Technische Phone Number ID, NICHT die Festnetznummer +4920227277835!
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Für Meta: im Dashboard unterstützte Graph-API-Version und App-Geheimnis.
WHATSAPP_API_VERSION=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
# Für freigegebene Vorlagen über Meta zusätzlich WABA-ID.
WHATSAPP_WABA_ID=
# Für 360dialog: langer zufälliger Token, als X-Krautl-Webhook-Token konfigurieren.
WHATSAPP_WEBHOOK_TOKEN=
